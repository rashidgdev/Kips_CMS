DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite (default). Example for Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/kips_cms

# Windows: npm ships as npm.cmd
NPM_BIN_PATH=npm.cmd
