# Base URL of the Django REST API, including the /api/v1 prefix.
#
# Testing on a physical phone via Expo Go: use this PC's LAN IP (not
# localhost/127.0.0.1 - the phone can't reach that). Find it with
# `ipconfig` (Windows, look for "IPv4 Address" on your Wi-Fi adapter).
# Django must also be started with `python manage.py runserver 0.0.0.0:8000`
# and that IP added to DJANGO_ALLOWED_HOSTS in the project root .env.
#
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8000/api/v1

# Android emulator only (not a physical device): 10.0.2.2 reaches the
# host machine's localhost. iOS Simulator (Mac only): 127.0.0.1 works
# directly. Physical devices (Android or iOS) must use the LAN IP above.
